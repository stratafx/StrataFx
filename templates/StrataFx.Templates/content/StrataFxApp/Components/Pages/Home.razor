@page "/"
@inject AppModel Model
@inject IPermissionService Permissions

<PageTitle>@Model.Title</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@Model.Title</MudText>
<MudText Class="mb-6">
    Every page below is generated by StrataFx from the classes in <code>Models/Entities.cs</code>,
    customized by <code>model.json</code>.
</MudText>

<MudGrid>
    @foreach (var entity in Model.Entities
                 .Where(e => e.VisibleInNavigation && Permissions.IsAllowed(e.ClrType, EntityOperation.Read))
                 .OrderBy(e => e.NavigationGroup).ThenBy(e => e.Order))
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@(entity.Icon ?? Icons.Material.Outlined.TableRows)" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">@entity.PluralCaption</MudText>
                    </MudStack>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="@StrataRoutes.List(entity)" Color="Color.Primary">Open</MudButton>
                    @if (Permissions.IsAllowed(entity.ClrType, EntityOperation.Create))
                    {
                        <MudButton Href="@StrataRoutes.New(entity)">New</MudButton>
                    }
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>
