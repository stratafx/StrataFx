<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>StrataFx core: the application model and its layers (code, modules, JSON, per-user), modules, commands, rules, save and change handlers, role-based permissions and the storage-agnostic IDataStore. No UI or ORM dependencies.</Description>
    <PackageTags>$(PackageTags);model;application-model;security</PackageTags>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
