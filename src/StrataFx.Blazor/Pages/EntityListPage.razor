@page "/app/{EntityId}"
@inject IAppModelProvider Models
@inject IPermissionService Permissions

@if (_entity is null)
{
    <PageTitle>Not found</PageTitle>
    <MudAlert Severity="Severity.Warning">There is no page called "@EntityId".</MudAlert>
}
else if (!Permissions.IsAllowed(_entity.ClrType, EntityOperation.Read))
{
    <PageTitle>No access · @Model.Title</PageTitle>
    <StrataAccessDenied Entity="_entity" />
}
else
{
    <PageTitle>@_entity.PluralCaption · @Model.Title</PageTitle>
    <EntityListView Entity="_entity" />
}

@code {
    private EntityModel? _entity;
    private AppModel Model = null!;

    [Parameter] public string EntityId { get; set; } = "";

    // The model in use when the page is navigated to; a model rebuilt by the designer shows on the next navigation.
    protected override void OnParametersSet()
    {
        Model = Models.Current;
        _entity = Model.FindEntity(EntityId);
    }
}
