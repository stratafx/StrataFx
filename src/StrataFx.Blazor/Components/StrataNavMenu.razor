@* Navigation generated from the application model: one group per NavigationGroup, one link per readable entity. *@
@inject AppModel Model
@inject IPermissionService Permissions

<MudNavMenu>
    @ChildContent
    @foreach (var group in Model.NavigationGroups())
    {
        var entities = group.Where(e => Permissions.IsAllowed(e.ClrType, EntityOperation.Read)).ToList();
        if (entities.Count == 0) continue;
        <MudNavGroup Title="@group.Key" Expanded="true">
            @foreach (var entity in entities)
            {
                <MudNavLink Href="@StrataRoutes.List(entity)" Match="NavLinkMatch.Prefix"
                            Icon="@(entity.Icon ?? Icons.Material.Outlined.TableRows)">
                    @entity.PluralCaption
                </MudNavLink>
            }
        </MudNavGroup>
    }
</MudNavMenu>

@code {
    /// <summary>Extra links shown above the generated groups (e.g. Home).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
