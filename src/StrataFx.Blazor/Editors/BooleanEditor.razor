@inherits PropertyEditorBase

<MudCheckBox T="bool"
             Label="@(Compact ? null : Property.Caption)"
             Dense="@Compact"
             Value="@(Value as bool? ?? false)"
             ValueChanged="@(v => SetValueAsync(v))"
             ReadOnly="@IsReadOnly"
             Color="Color.Primary" />
@if (HasError)
{
    <MudText Typo="Typo.caption" Color="Color.Error">@Error</MudText>
}
