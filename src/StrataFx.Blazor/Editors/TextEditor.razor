@inherits PropertyEditorBase

<MudTextField T="string"
              Label="@Label"
              Value="@(Value as string)"
              ValueChanged="@(v => SetValueAsync(string.IsNullOrEmpty(v) && Property.IsNullable ? null : v ?? ""))"
              Lines="@Math.Max(1, Property.Lines)"
              Sizing="@(Property.Lines > 1 ? InputSizing.Auto : InputSizing.Fixed)"
              MaxLength="@(Property.MaxLength ?? 524288)"
              ReadOnly="@IsReadOnly"
              Error="@HasError"
              ErrorText="@Error"
              HelperText="@HelperText"
              Margin="@EditorMargin"
              Variant="Variant.Outlined" />
