@* Put in AuthorizeRouteView's NotAuthorized: sends the user to sign in, and back here afterwards. *@
@inject NavigationManager Navigation

@code {
    protected override void OnInitialized()
    {
        var returnUrl = Navigation.ToBaseRelativePath(Navigation.Uri);
        Navigation.NavigateTo(StrataRoutes.WithQuery(StrataIdentityRoutes.Login, (StrataRoutes.ReturnUrlParameter, returnUrl)), forceLoad: true);
    }
}
