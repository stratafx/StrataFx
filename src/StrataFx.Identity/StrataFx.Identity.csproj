<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>ASP.NET Core Identity for StrataFx: sign-in, sign-out and access-denied pages, a user menu, users and roles for the role-based permission policy, and a role and user seeder.</Description>
    <PackageTags>$(PackageTags);identity;authentication;aspnetcore</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StrataFx.Blazor\StrataFx.Blazor.csproj" />
  </ItemGroup>

</Project>
