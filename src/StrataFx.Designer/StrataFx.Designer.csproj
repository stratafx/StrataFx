<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>The StrataFx model designer: an admin-only page to customize the application model visually (captions, navigation, columns, forms, editors) with a live preview, saved to model.json in development or to the database, and applied without a restart.</Description>
    <PackageTags>$(PackageTags);designer;blazor;mudblazor</PackageTags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StrataFx.Blazor\StrataFx.Blazor.csproj" />
  </ItemGroup>

</Project>
