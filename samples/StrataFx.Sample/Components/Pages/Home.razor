@page "/"
@inject AppModel Model

<PageTitle>@Model.Title</PageTitle>

<MudText Typo="Typo.h4" GutterBottom="true">@Model.Title</MudText>
<MudText Class="mb-6">
    Every page below is generated by StrataFx from plain C# classes in <code>Sales/Entities.cs</code>,
    customized by <code>SalesModule</code> and the <code>model.json</code> layer.
</MudText>

<MudGrid>
    @foreach (var entity in Model.Entities.Where(e => e.VisibleInNavigation).OrderBy(e => e.NavigationGroup).ThenBy(e => e.Order))
    {
        <MudItem xs="12" sm="6" md="4">
            <MudCard Elevation="1">
                <MudCardContent>
                    <MudStack Row="true" AlignItems="AlignItems.Center">
                        <MudIcon Icon="@(entity.Icon ?? Icons.Material.Outlined.TableRows)" Color="Color.Primary" />
                        <MudText Typo="Typo.h6">@entity.PluralCaption</MudText>
                    </MudStack>
                    <MudText Typo="Typo.body2" Class="mt-2">
                        @entity.NavigationGroup · @entity.ListColumns.Count() columns · @entity.DetailItems.Count() fields
                    </MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Href="@StrataRoutes.List(entity)" Color="Color.Primary">Open</MudButton>
                    <MudButton Href="@StrataRoutes.New(entity)">New</MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    }
</MudGrid>
