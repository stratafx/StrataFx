// A JSON model layer, applied on top of the model built from the entity classes.
// Change captions, visibility, order or navigation here without recompiling. Sign in as admin and use the model
// designer (/strata/designer) to change it visually: it edits this file in place, keeping these comments.
{
  "title": "StrataFx Sample",
  "entities": {
    "product": {
      "navigationGroup": "Catalog"
    },
    "customer": {
      "properties": {
        "Phone": { "visibleInList": false },
        "CreatedOn": { "visibleInList": false },
        "Orders": { "caption": "Order history" }
      }
    },
    "order": {
      "properties": {
        "ShippedOn": { "visibleInList": false }
      }
    },
    "orderline": {
      "properties": {
        "Quantity": { "caption": "Qty" }
      }
    }
  }
}
